# Copy to server/.env and edit before the event.

# Administrator password for the control room (REQUIRED – the fallback is insecure).
ADMIN_PASSWORD=change-me-before-the-event

# HTTP port. In production the server also serves the built client from this port.
PORT=4000

# Where the SQLite database lives (default: ../database next to the server folder).
# DB_DIR=D:/ITA_projects/Code_Auction/database

# How many submissions are judged in parallel (default 2).
# JUDGE_CONCURRENCY=2

# Interpreter overrides for the judge machine.
# PYTHON_BIN=python3
